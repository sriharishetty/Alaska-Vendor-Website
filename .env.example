# ==============================================================================
# PRODUCTION OPERATIONS CONNECT — VENDOR MAINTENANCE MODULE
# Environment Configuration Template (.env.example)
# Copy this file to .env for local or production backend execution.
# NEVER commit real secrets, client secrets, or tokens to source control.
# NEVER place secrets in VITE_* variables (frontend variables are public).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Server Configuration
# ------------------------------------------------------------------------------
VENDOR_MAINTENANCE_PORT=4050

# Shared secret or bearer token used to authenticate incoming requests from
# Power Automate HTTP actions and administrative mutation endpoints.
# Generate a strong random 256-bit key for production (e.g., openssl rand -hex 32)
VENDOR_MAINTENANCE_WEBHOOK_SECRET=replace-with-strong-webhook-secret-in-production

# Maximum allowed JSON request payload size in bytes (default: 2097152 = 2 MB)
VENDOR_MAINTENANCE_MAX_BODY_BYTES=2097152

# Rate limiting configuration per client IP
VENDOR_MAINTENANCE_RATE_LIMIT_WINDOW_MS=60000
VENDOR_MAINTENANCE_RATE_LIMIT_MAX_REQUESTS=60

# ------------------------------------------------------------------------------
# 2. Outlook Mailbox & Folder Configuration
# ------------------------------------------------------------------------------
# Monitored shared/operations mailbox address
OUTLOOK_MONITORED_MAILBOX=vendor-maintenance@alaskaair.example.com

# Target folder inside the monitored mailbox (nested or top-level)
OUTLOOK_MONITORED_FOLDER_NAME=Vendor Maintenance

# Optional comma-separated list of approved external vendor sender domains
# Leave blank to allow all vendor domains from master-data.js plus manual review
OUTLOOK_APPROVED_SENDER_DOMAINS=sita.aero,smart4aviation.aero,jeppesen.com,trax.aero,airbus.com,aireon.com,aerodata.aero,dynamicsource.se,ames.aero

# ------------------------------------------------------------------------------
# 3. Storage Provider Configuration
# ------------------------------------------------------------------------------
# Supported values:
#   local-json -> Local persistent JSON database (server/data/vendor-maintenance-db.json)
VENDOR_MAINTENANCE_STORAGE_PROVIDER=local-json

# ------------------------------------------------------------------------------
# 4. Frontend Public Variables (Safe for Browser Exposure ONLY)
# ------------------------------------------------------------------------------
# Base URL of the Vendor Maintenance Backend API
VITE_VENDOR_MAINTENANCE_API_URL=http://localhost:4050/api/vendor-maintenance

